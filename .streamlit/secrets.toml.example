# Copy to secrets.toml for local dev, or paste into Streamlit Cloud "Secrets".
# Never commit the real secrets.toml.

DATABASE_URL = "postgresql://user:password@host:5432/dbname?sslmode=require"

# Bootstrap master account created on first init_db run.
# Change the password after first login.
BOOTSTRAP_MASTER_USERNAME = "master"
BOOTSTRAP_MASTER_PASSWORD = "change-me-on-first-login"
BOOTSTRAP_MASTER_DISPLAY_NAME = "Game Master"

# Optional: name of the default campaign created at bootstrap.
DEFAULT_CAMPAIGN_NAME = "Aethermoor"
